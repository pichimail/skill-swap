# Neon Postgres
DATABASE_URL=

# Upstash Redis - required in production for AI rate limiting and roadmap cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional compatibility aliases when supplied by a Vercel-managed KV/Redis resource.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Google OAuth via NextAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Production canonical origin. Local development should use http://localhost:3000 instead.
NEXTAUTH_URL=https://skill-swap-nine-green.vercel.app

# Vercel Blob avatar storage.
# New Blob stores connected to Vercel can use project OIDC automatically with @vercel/blob 2.8+.
# Older token-based stores can provide this variable instead.
BLOB_READ_WRITE_TOKEN=

# AI provider priority: NVIDIA first, OpenRouter fallback.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_SITE_URL=https://skill-swap-nine-green.vercel.app
OPENROUTER_APP_NAME=Skill Swap

# LiveKit Cloud/self-hosted realtime transport.
LIVEKIT_URL=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
