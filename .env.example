# Provision with Vercel Marketplace -> Neon. The integration injects DATABASE_URL.
DATABASE_URL=

# Provision with Vercel Marketplace -> Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Some Vercel-managed Upstash resources can expose KV_* aliases instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Existing AI provider
NVIDIA_API_KEY=

# Firebase auth remains separate from the database layer.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
